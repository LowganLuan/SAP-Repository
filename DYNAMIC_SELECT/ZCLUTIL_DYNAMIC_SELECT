CLASS ZCLUTIL_DYNAMIC_SELECT IMPLEMENTATION.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Instance Private Method ZCLUTIL_DYNAMIC_SELECT->BUILD_WHERE_DATA_W_V_FIELDS
* +-------------------------------------------------------------------------------------------------+
* | [--->] IT_VALID_VALUES                TYPE        TY_T_VALID_FIELDS
* | [--->] IV_WHERE_DATA_VALUES           TYPE        DATA
* | [<-->] CV_WHERE                       TYPE        STRING
* +--------------------------------------------------------------------------------------</SIGNATURE>
METHOD build_where_data_w_v_fields.

  " Build a dynamic WHERE clause from valid fields and the provided input values.
  " Only fields present in the input structure are used; missing or invalid fields
  " are represented as blank values so the query still resolves the structure.

  DATA: lo_descr        TYPE REF TO cl_abap_structdescr,
        lt_comp_dvalue  TYPE abap_component_tab,
        ls_valid_values LIKE LINE OF it_valid_values,
        ls_comp_dvalue  LIKE LINE OF lt_comp_dvalue,
        lv_count_table  TYPE i,
        lv_tabix        TYPE sy-tabix,
        lv_operator     TYPE char3,
        lv_not_pass_val TYPE abap_bool,
        lv_literal      TYPE string.

  FIELD-SYMBOLS: <fl_value> TYPE any.



  lo_descr ?= cl_abap_structdescr=>describe_by_data( p_data = iv_where_data_values ).
  IF sy-subrc IS INITIAL.

    lt_comp_dvalue = lo_descr->get_components( ).
    DESCRIBE TABLE lt_comp_dvalue LINES lv_count_table.

    LOOP AT lt_comp_dvalue INTO ls_comp_dvalue.

      lv_tabix = sy-tabix.

      READ TABLE it_valid_values INTO ls_valid_values WITH KEY field = ls_comp_dvalue-name.
      IF sy-subrc IS NOT INITIAL.
        " Field is not valid for filtering, so mark it as not passing validation.
        lv_not_pass_val = abap_true.
      ENDIF.

      ASSIGN COMPONENT ls_comp_dvalue-name OF STRUCTURE iv_where_data_values TO <fl_value>.
      IF <fl_value> IS ASSIGNED.

        me->get_sql_literal_for_component(
                                           EXPORTING
                                             iv_type   = ls_comp_dvalue-type
                                             iv_value  = <fl_value>
                                           CHANGING
                                             cv_literal = lv_literal ).

        lv_operator = 'AND'.
        IF lv_tabix EQ lv_count_table.
          CLEAR lv_operator.
        ENDIF.

        IF cv_where IS INITIAL.

          IF lv_not_pass_val IS NOT INITIAL.

            cv_where = |{ ls_comp_dvalue-name } = ' ' |.

          ELSE.

            cv_where = |{ ls_comp_dvalue-name } = { lv_literal } |.

          ENDIF.

        ELSE.

          IF lv_not_pass_val IS NOT INITIAL.

            cv_where = |{ cv_where }{ ls_comp_dvalue-name } = ' ' |.

          ELSE.

            cv_where = |{ cv_where }{ ls_comp_dvalue-name } = { lv_literal } |.

          ENDIF.

        ENDIF.

        IF lv_operator IS NOT INITIAL.

          cv_where = |{ cv_where }{ lv_operator } |.

        ENDIF.

      ENDIF.

      CLEAR: lv_not_pass_val, ls_valid_values, lv_literal.

    ENDLOOP.

  ENDIF.


ENDMETHOD.


