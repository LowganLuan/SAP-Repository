method CONSTRUCTOR.
endmethod.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Instance Private Method ZCLUTIL_DYNAMIC_SELECT->GET_ACCESS_SEQUENCE
* +-------------------------------------------------------------------------------------------------+
* | [--->] IV_TABNAME                     TYPE        DATA
* | [<-->] CT_DATA                        TYPE        DATA
* | [EXC!] NO_DATA
* +--------------------------------------------------------------------------------------</SIGNATURE>
METHOD get_access_sequence.

  " Dynamically select all rows from the access sequence table.
  FIELD-SYMBOLS: <fs_tdata> TYPE ANY TABLE.

  ASSIGN ct_data->* TO <fs_tdata>.

  IF <fs_tdata> IS ASSIGNED.

    SELECT *
      INTO TABLE <fs_tdata>
     FROM (iv_tabname).

    IF sy-subrc IS NOT INITIAL.
      RAISE no_data.
    ENDIF.

  ENDIF.



ENDMETHOD.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Instance Private Method ZCLUTIL_DYNAMIC_SELECT->GET_DATA_FROM_SEQUENCE
* +-------------------------------------------------------------------------------------------------+
* | [--->] IV_DATA_FIELDS                 TYPE        DATA
* | [--->] IV_TABNAME_DATA                TYPE        DATA
* | [--->] IV_WHERE_DATA_VALUES           TYPE        DATA
* | [<-->] CT_TABLE_VALUES                TYPE        DATA
* | [EXC!] NO_DATA
* +--------------------------------------------------------------------------------------</SIGNATURE>
METHOD get_data_from_sequence.

  " Iterate through the access sequence rows, build the WHERE clause for each row,
  " and fetch matching rows from the target data table.
  DATA: lt_valid_fields TYPE ty_t_valid_fields,
        lv_where TYPE string.

  FIELD-SYMBOLS: <fs_data> TYPE ANY TABLE,
                 <fs_tdata_f> TYPE ANY TABLE,
                 <fs_sdata_f> TYPE any.


  ASSIGN iv_data_fields->* TO <fs_tdata_f>.
  IF <fs_tdata_f> IS NOT ASSIGNED.
    RETURN.
  ENDIF.

  ASSIGN ct_table_values TO <fs_data>.
  IF <fs_data> IS NOT ASSIGNED.
    RETURN.
  ENDIF.

  LOOP AT <fs_tdata_f> ASSIGNING <fs_sdata_f>.

    me->get_only_valid_fields( EXPORTING
                                  iv_data_fields  = <fs_sdata_f>
                                  iv_tabname_data = iv_tabname_data
                               CHANGING
                                  ct_table_values = lt_valid_fields ).

    me->build_where_data_w_v_fields( EXPORTING
                                        it_valid_values      = lt_valid_fields
                                        iv_where_data_values = iv_where_data_values
                                     CHANGING
                                        cv_where = lv_where
                                     ).
    CLEAR <fs_data>.
    REFRESH <fs_data>.

    SELECT *
        INTO TABLE <fs_data>
       FROM (iv_tabname_data)
      WHERE (lv_where)
     ORDER BY PRIMARY KEY.

    IF sy-subrc IS INITIAL.
      EXIT.
    ENDIF.

    CLEAR: lt_valid_fields, lv_where.
    REFRESH lt_valid_fields.

  ENDLOOP.

ENDMETHOD.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Instance Private Method ZCLUTIL_DYNAMIC_SELECT->GET_ONLY_VALID_FIELDS
* +-------------------------------------------------------------------------------------------------+
* | [--->] IV_DATA_FIELDS                 TYPE        DATA
* | [--->] IV_TABNAME_DATA                TYPE        DATA
* | [<-->] CT_TABLE_VALUES                TYPE        TY_T_VALID_FIELDS
* +--------------------------------------------------------------------------------------</SIGNATURE>
METHOD get_only_valid_fields.

  " Determine which fields from the current access sequence row are valid for the data table.
  " Only append those field names that exist in the target table structure.
  DATA: lo_descr TYPE REF TO cl_abap_structdescr,
        lo_data TYPE REF TO data,
        lt_comp_dfields TYPE abap_component_tab,
        lt_comp_data TYPE abap_component_tab,
        ls_comp_dfields LIKE LINE OF lt_comp_dfields,
        ls_comp_data LIKE LINE OF lt_comp_data.

  FIELD-SYMBOLS <fs_data_fields> TYPE any.
  FIELD-SYMBOLS <fs_value_field> TYPE any.

  ASSIGN iv_data_fields TO <fs_data_fields>.

  lo_descr ?= cl_abap_structdescr=>describe_by_name( p_name = iv_tabname_data ).

  IF sy-subrc IS INITIAL.

    lt_comp_data = lo_descr->get_components( ).

  ENDIF.

  CLEAR lo_descr.

  lo_descr ?= cl_abap_structdescr=>describe_by_data( p_data = <fs_data_fields> ).

  IF sy-subrc IS INITIAL.

    lt_comp_dfields = lo_descr->get_components( ).
    CLEAR lo_descr.

    LOOP AT lt_comp_dfields INTO ls_comp_dfields.

      ASSIGN COMPONENT ls_comp_dfields-name OF STRUCTURE <fs_data_fields> TO <fs_value_field>.
      IF <fs_value_field> IS ASSIGNED.

        READ TABLE lt_comp_data INTO ls_comp_data WITH KEY name = <fs_value_field>.
        IF sy-subrc IS INITIAL.

          APPEND <fs_value_field> TO ct_table_values.

        ENDIF.

      ENDIF.

    ENDLOOP.

  ENDIF.

ENDMETHOD.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Instance Private Method ZCLUTIL_DYNAMIC_SELECT->GET_SQL_LITERAL_FOR_COMPONENT
* +-------------------------------------------------------------------------------------------------+
* | [--->] IV_TYPE                        TYPE REF TO CL_ABAP_DATADESCR
* | [--->] IV_VALUE                       TYPE        DATA
* | [<-->] CV_LITERAL                     TYPE        DATA
* +--------------------------------------------------------------------------------------</SIGNATURE>
METHOD get_sql_literal_for_component.

  " Convert the field value into a SQL literal based on the ABAP data type.
  " Strings are escaped and quoted, date/time values are normalized,
  " and numeric values are returned without quotes.
  DATA lv_text TYPE string.

  CASE iv_type->type_kind.
    WHEN cl_abap_typedescr=>typekind_char
       OR cl_abap_typedescr=>typekind_string
       OR cl_abap_typedescr=>typekind_clike.
      lv_text = iv_value.
      " Escape single quotes in string literals.
      TRY.
          lv_text = cl_abap_dyn_prg=>escape_quotes( lv_text ).
        CATCH cx_root.
          REPLACE ALL OCCURRENCES OF '''' IN lv_text WITH ''''''.
      ENDTRY.
      cv_literal = |'{ lv_text }'|.

    WHEN iv_type->typekind_date.
      " DATS: assume YYYYMMDD in the content.
      lv_text = iv_value.
      CONDENSE lv_text NO-GAPS.
      cv_literal = |'{ lv_text }'|.

    WHEN iv_type->typekind_time.
      " TIMS: expect HHMMSS format.
      lv_text = iv_value.
      CONDENSE lv_text NO-GAPS.
      cv_literal = |'{ lv_text }'|.

    WHEN OTHERS.
      " Numeric/decimal values: no quotes; remove whitespace.
      lv_text = iv_value.
      CONDENSE lv_text NO-GAPS.
      cv_literal = lv_text.
  ENDCASE.

ENDMETHOD.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Instance Protected Method ZCLUTIL_DYNAMIC_SELECT->SELECT_DATA
* +-------------------------------------------------------------------------------------------------+
* | [--->] IV_TABNAME_SEQ                 TYPE        TABNAME16
* | [--->] IV_TABNAME_DATA                TYPE        TABNAME16
* | [--->] IV_WHERE_DATA_VALUES           TYPE        DATA
* | [<-->] CT_TABLE_VALUES                TYPE        DATA
* +--------------------------------------------------------------------------------------</SIGNATURE>
METHOD select_data.

  " Prepare a dynamic internal table for the access sequence and then fetch data.
  DATA: lt_data TYPE REF TO data.

  CREATE DATA lt_data TYPE TABLE OF (iv_tabname_seq).

  me->get_access_sequence(
    EXPORTING
      iv_tabname = iv_tabname_seq
    CHANGING
      ct_data    = lt_data
    EXCEPTIONS
      no_data    = 4
  ).

  CHECK sy-subrc IS INITIAL.

  me->get_data_from_sequence( EXPORTING
                                iv_data_fields       = lt_data
                                iv_tabname_data      = iv_tabname_data
                                iv_where_data_values = iv_where_data_values
                              CHANGING
                                ct_table_values = ct_table_values
                              EXCEPTIONS
                                no_data = 4
                              ).



ENDMETHOD.
ENDCLASS.